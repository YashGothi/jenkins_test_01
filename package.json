{
  "name": "jenkins-demo",
  "version": "1.0.0",
  "description": "Sample app for a Jenkins build-test-deploy pipeline",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest --ci --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^6.3.4"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}
